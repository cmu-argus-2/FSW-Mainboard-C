# SPDX-License-Identifier: Apache-2.0

if BOARD_ARGUS

config USB_SELF_POWERED
	default n

# Needed to turn on the peripheral 3.3V rail (periph_3v3).
config REGULATOR
	default y

# The DesignWare I2C driver derives SCL timing from this (MHz). RP2350 clk_sys
# is 150 MHz; the driver default of 32 runs the bus ~4.7x too fast.
if I2C_DW

config I2C_DW_CLOCK_SPEED
	default 150

endif # I2C_DW

# Console and shell go over USB CDC ACM, like CircuitPython's REPL does.
source "boards/common/usb/Kconfig.cdc_acm_serial.defconfig"

endif # BOARD_ARGUS
