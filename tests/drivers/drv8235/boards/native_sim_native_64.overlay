/ {
	test_regulators {
		compatible = "zephyr,fake-regulator";
		test_coil_power: test-coil-power {
			regulator-name = "test_coil_power";
			regulator-boot-on;
		};
	};
};

&i2c0 {
	drv8235_test: drv8235@30 {
		compatible = "ti,drv8235";
		reg = <0x30>;
		max-output-microvolt = <6000000>;
		coil-resistance-milliohm = <25000>;
		imtr-full-scale-microamp = <3700000>;
		vm-supply = <&test_coil_power>;
		status = "okay";
	};
};
