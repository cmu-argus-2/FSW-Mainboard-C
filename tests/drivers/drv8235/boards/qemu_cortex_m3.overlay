#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	i2c0: i2c@100 {
		compatible = "zephyr,i2c-emul-controller";
		reg = <0x100 0x4>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		#forward-cells = <1>;
		status = "okay";

		drv8235_test: drv8235@30 {
			compatible = "ti,drv8235";
			reg = <0x30>;
			status = "okay";
		};
	};
};
