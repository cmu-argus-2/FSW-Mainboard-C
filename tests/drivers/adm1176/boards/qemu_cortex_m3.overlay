#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	i2c0: i2c@100 {
		compatible = "zephyr,i2c-emul-controller";
		reg = <0x100 4>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		adm1176_test: adm1176@40 {
			compatible = "adi,adm1176";
			reg = <0x40>;
			rshunt-micro-ohms = <10000>;
			status = "okay";
		};
	};
};
